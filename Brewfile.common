# Common bundle
# Common developer tooling

# Set arguments for installing casks
# https://github.com/homebrew/homebrew-cask/blob/master/USAGE.md#options
# Tip: Use `force: true` to override `require_sha: true` on individual casks
cask_args require_sha: true, no_quarantine: true

## Desktop Docker
cask "docker-desktop"           # App to build and share containerised applications and microservices
brew "docker-buildx"            # Docker CLI plugin for extended build capabilities with BuildKit
brew "docker-clean"             # Clean Docker containers, images, networks, and volumes
brew "docker-compose"           # Isolated development environments using Docker
brew "docker-credential-helper" # Platform keystore credential helper for Docker

## Formulae
brew "awscli"                # Official Amazon AWS command-line interface
brew "bat"                   # Clone of cat(1) with syntax highlighting and Git integration
brew "claude-cmd"            # Claude Code Commands Manager
brew "claude-code-templates" # CLI tool for configuring and monitoring Claude Code
brew "devcontainer"          # Reference implementation for the Development Containers specification
brew "difftastic"            # Diff that understands s˛yntax
brew "direnv"                # Load/unload environment variables based on $PWD
brew "dockutil"              # Command-line utility to manage applications in the macOS Dock
brew "fd"                    # Simple, fast and user-friendly alternative to find
brew "fzf"                   # Fuzzy finder
brew "gmailctl"              # Declarative configuration for Gmail filters
brew "httpie"                # User-friendly cURL replacement (command-line HTTP client)
brew "imagemagick"           # Tools and libraries to manipulate images in many formats
brew "jq"                    # Lightweight and flexible command-line JSON processor
brew "lazygit"               # Simple terminal UI for git commands
brew "mackup"                # Keep your Mac's application settings in sync
brew "markdownlint-cli"      # CLI for Node.js style checker and lint tool for Markdown files
brew "micro"                 # Modern and intuitive terminal-based text editor
brew "notify"                # Stream the output of any CLI and publish it to a variety of supported platforms
brew "ox"                    # Independent Rust text editor that runs in your terminal
brew "pandoc"                # Swiss-army knife of markup format conversion
brew "pgcli"                 # CLI for Postgres with auto-completion and syntax highlighting
brew "rubyfmt"               # Ruby autoformatter
brew "shfmt"                 # Autoformat shell script source code
brew "terminal-notifier"     # Send macOS User Notifications from the command-line
brew "watch"                 # Executes a program periodically, showing output fullscreen
brew "watchman"              # Watches files and records when they change
brew "worktrunk"             # CLI for Git worktree management, designed for parallel AI agent workflows

## Casks
cask "1password"      # Password manager that keeps all passwords secure behind one password
cask "1password-cli"  # Command-line interface for 1Password
cask "alacritty"      # GPU-accelerated terminal emulator
cask "alfred"         # Application launcher and productivity software
# cask "claude"               # Anthropic's official Claude AI desktop app
cask "claude-code"    # Terminal-based AI coding assistant
cask "deckset"        # Presentations from Markdown
cask "divvy"          # Application window manager focusing on simplicity
cask "dropbox"        # Client for the Dropbox cloud storage service
cask "freeze"         # Amazon Glacier file transfer client
cask "google-gemini"  # Native desktop AI assistant from Google
cask "keycombiner"    # Learn and practice keyboard shortcuts
cask "macdown-3000"   # Open-source Markdown editor (replaces deprecated macdown)
cask "monitorcontrol" # Tool to control external monitor brightness & volume
cask "monodraw"       # ASCII art editor
cask "ngrok"          # Reverse proxy, secure introspectable tunnels to localhost
cask "notunes"        # Tool to disable iTunes launching when media keys are pressed
cask "slack"          # Team communication and collaboration software

